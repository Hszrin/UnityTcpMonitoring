<Window x:Class="UnityTcpMonitoringApp.Views.AddMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="신규 설비 추가" 
        Height="260" Width="420" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#1E1E1E">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340" >

            <TextBlock Text="⚙️ 기계 추가" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="기계 이름" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="생산 품목" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,6"/><TextBox Grid.Row="1" Grid.Column="0" 
                         Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}" 
                         Height="32" Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42" 
                         VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,10,20"/>

                <ComboBox Grid.Row="1" Grid.Column="1"  
          ItemsSource="{Binding ProductTypeList}" 
          SelectedItem="{Binding SelectedProductType}"
          Height="32" Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42" 
          VerticalContentAlignment="Center" Padding="6,0" Margin="10,0,0,20">

                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2D2D30"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White"/>
                    </ComboBox.Resources>
                </ComboBox>
            </Grid>

            <Button Content="추가"
        Command="{Binding AddMachineCommand}" 
        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
        Width="110" Height="32"
        HorizontalAlignment="Center"
        Background="#0078D7" Foreground="White" FontWeight="Bold"
        BorderThickness="0"/>
        </StackPanel>

    </Grid>
</Window>