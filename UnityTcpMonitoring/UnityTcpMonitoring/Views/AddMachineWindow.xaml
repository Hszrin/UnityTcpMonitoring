<Window x:Class="UnityTcpMonitoring.Views.AddMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="신규 설비 추가"
        Height="220" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#1E1E1E">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">
            <TextBlock Text="⚙️ 기계 추가" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
            <TextBlock Text="기계 이름" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}"
                     Height="32" Background="#2D2D30" Foreground="White" BorderBrush="#3E3E42"
                     VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,20"/>
            <Button Content="추가"
                    Command="{Binding AddMachineCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Width="110" Height="32"
                    HorizontalAlignment="Center"
                    Background="#0078D7" Foreground="White" FontWeight="Bold"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
