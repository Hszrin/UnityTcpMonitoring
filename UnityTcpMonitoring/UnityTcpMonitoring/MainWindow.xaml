<Window x:Class="UnityTcpMonitoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UnityTcpMonitoring.ViewModels" 
        xmlns:views="clr-namespace:UnityTcpMonitoring.Views"
        Title="MES System" Height="500" Width="800" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingViewModel}">
            <views:SettingView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#2D2D30" Margin="10">
            <TextBlock Text="MENU" Foreground="Gray" FontSize="12" FontWeight="Bold" Margin="5,10,0,20"/>

            <Button Content="📊 대시보드" Command="{Binding MoveToDashboardCommand}" 
                    Height="40" Margin="0,0,0,10" Background="#3E3E42" Foreground="White" BorderThickness="0"/>

            <Button Content="⚙️ 환경설정" Command="{Binding MoveToSettingCommand}" 
                    Height="40" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="15"/>
    </Grid>
</Window>